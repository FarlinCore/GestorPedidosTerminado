@page
@using PedidosRazorDemo.Models
@model PedidosRazorDemo.Pages.IndexModel
@{
    ViewData["Title"] = "Pedidos y Entregas";
}

<div class="container-fluid px-4 my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h5 mb-0">Pedidos y Entregas</h2>
        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#nuevoPedidoModal">
            Nuevo Pedido
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert @(Model.EsError ? "alert-danger" : "alert-success") small py-2" role="alert">
            @Model.Mensaje
        </div>
    }

    <!-- Modal Nuevo Pedido -->
    <div class="modal fade" id="nuevoPedidoModal" tabindex="-1" aria-labelledby="nuevoPedidoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fs-6" id="nuevoPedidoModalLabel">Nuevo Pedido</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body small">
                    <form method="post" asp-page-handler="Crear">
                        <div class="mb-3">
                            <label asp-for="Cliente" class="form-label">Cliente</label>
                            <input asp-for="Cliente" type="text" class="form-control form-control-sm" placeholder="Ej. Pedro Ramirez" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Direccion" class="form-label">Direccion</label>
                            <input asp-for="Direccion" type="text" class="form-control form-control-sm" placeholder="Ej. Calle Principal #10" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Subtotal" class="form-label">Subtotal (Envio 150; gratis desde 2,000)</label>
                            <input asp-for="Subtotal" type="number" step="0.01" class="form-control form-control-sm" required />
                        </div>
                        <div class="mb-3">
                            <label asp-for="MinutosLimite" class="form-label">Tiempo limite (minutos)</label>
                            <input asp-for="MinutosLimite" type="number" min="1" class="form-control form-control-sm" required />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">Registrar pedido</button>
                    </form>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-3">
            <div class="card">
                <div class="card-body small">
                    <h6 class="card-title fw-semibold mb-3">Repartidores disponibles (@Model.RepartidoresDisponibles.Count)</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var rep in Model.RepartidoresDisponibles)
                        {
                            <li class="list-group-item px-0 py-2">@rep.Nombre</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="card-title fw-semibold mb-0">Pedidos (@Model.PedidosMostrados.Count)</h6>
                        <form method="get">
                            <div class="form-check small mb-0">
                                <input type="checkbox" class="form-check-input" id="soloPendientesChk" asp-for="SoloPendientes" onchange="this.form.submit()" />
                                <label class="form-check-label" for="soloPendientesChk">Mostrar solo pendientes</label>
                            </div>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle small mb-0">
                            <thead>
                                <tr>
                                    <th class="px-3 py-2">#</th>
                                    <th class="px-3 py-2">Cliente y direccion</th>
                                    <th class="px-3 py-2 text-nowrap">Subtotal</th>
                                    <th class="px-3 py-2 text-nowrap">Envio</th>
                                    <th class="px-3 py-2 text-nowrap">Total</th>
                                    <th class="px-3 py-2 text-nowrap">Estado</th>
                                    <th class="px-3 py-2 text-nowrap">Repartidor / Hora</th>
                                    <th class="px-3 py-2">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.PedidosMostrados)
                                {
                                    <tr>
                                        <td class="px-3 py-2 text-nowrap"><strong>@p.Id</strong></td>
                                        <td class="px-3 py-2">
                                            <div class="fw-semibold text-nowrap">@p.Cliente</div>
                                            <div class="text-muted">@p.Direccion</div>
                                        </td>
                                        <td class="px-3 py-2 text-nowrap">@p.Subtotal.ToString("N2")</td>
                                        <td class="px-3 py-2 text-nowrap">@p.CostoEnvio.ToString("N2")</td>
                                        <td class="px-3 py-2 text-nowrap"><strong>@p.Total.ToString("N2")</strong></td>
                                        <td class="px-3 py-2 text-nowrap">
                                            <strong>@p.Estado</strong>
                                            @if (p.EstaAtrasado)
                                            {
                                                <div class="mt-1"><span class="badge bg-danger">ATRASADO</span></div>
                                            }
                                        </td>
                                        <td class="px-3 py-2 text-nowrap">
                                            <div>@(p.NombreRepartidor ?? "Sin asignar")</div>
                                            <div class="text-muted">Limite: @p.FechaLimiteEntrega.ToString("HH:mm")</div>
                                            @if (p.FechaEntregaReal.HasValue)
                                            {
                                                <div class="text-muted">Entregado: @p.FechaEntregaReal.Value.ToString("HH:mm")</div>
                                            }
                                        </td>
                                        <td class="px-3 py-2">
                                            <form method="post" asp-page-handler="Estado" class="d-flex gap-2 align-items-center mb-1">
                                                <input type="hidden" name="pedidoId" value="@p.Id" />
                                                <input type="hidden" name="SoloPendientes" value="@Model.SoloPendientes" />
                                                <select name="nuevoEstado" class="form-select form-select-sm w-auto">
                                                    @foreach (EstadoPedido est in Enum.GetValues<EstadoPedido>())
                                                    {
                                                        <option value="@est">@est</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-primary btn-sm">Cambiar</button>
                                            </form>

                                            @if (p.Estado == EstadoPedido.Confirmado)
                                            {
                                                <form method="post" asp-page-handler="Asignar" class="d-flex gap-2 align-items-center mb-1">
                                                    <input type="hidden" name="pedidoId" value="@p.Id" />
                                                    <input type="hidden" name="SoloPendientes" value="@Model.SoloPendientes" />
                                                    <select name="repartidorId" class="form-select form-select-sm w-auto">
                                                        @foreach (var rep in Model.RepartidoresDisponibles)
                                                        {
                                                            <option value="@rep.Id">@rep.Nombre</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-primary btn-sm">Asignar</button>
                                                </form>
                                            }

                                            @if (p.Estado == EstadoPedido.EnRuta)
                                            {
                                                <form method="post" asp-page-handler="Entregar" class="d-flex gap-2 align-items-center">
                                                    <input type="hidden" name="pedidoId" value="@p.Id" />
                                                    <input type="hidden" name="SoloPendientes" value="@Model.SoloPendientes" />
                                                    <button type="submit" class="btn btn-success btn-sm">Entregar</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>